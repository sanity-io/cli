 import { readFile } from 'node:fs/promises';
-import { resolve, dirname } from 'node:path';
+import { resolve, dirname, extname } from 'node:path';
+
+/**
+ * Parses a DSDS file, supporting both JSON (.dsds.json) and YAML (.dsds.yaml).
+ * Returns the parsed document object.
+ */
+async function parseFile(absPath, raw) {
+  if (extname(absPath) === '.yaml' || extname(absPath) === '.yml') {
+    const { parse } = await import('yaml');
+    return parse(raw);
+  }
+  return JSON.parse(raw);
+}
+
+/**
+ * Returns true if the document follows the 0.20.0+ schema (entries-based).
+ * Detects by presence of `schemaVersion` or `entries` array.
+ */
+function isV020(doc) {
+  return doc.schemaVersion !== undefined || Array.isArray(doc.entries);
+}
+
+/**
+ * Normalizes a 0.20.0 entry to the internal representation used by all tools.
+ * Maps `id` → `identifier` and leaves all other fields intact so tools can
+ * inspect both old and new fields without conditional checks everywhere.
+ */
+function normalizeEntry(entry) {
+  if (!entry || typeof entry !== 'object') return entry;
+  const normalized = { ...entry };
+  // Map `id` to `identifier` for backward compat with tools that read `identifier`.
+  // Keep `id` as well so 0.20.0-aware code can use it directly.
+  if (normalized.id !== undefined && normalized.identifier === undefined) {
+    normalized.identifier = normalized.id;
+  }
+  // Map `sections` to `documentBlocks`/`agentDocumentBlocks` for tool compat.
+  if (Array.isArray(normalized.sections) && !normalized.documentBlocks) {
+    normalized.documentBlocks = normalized.sections.filter(
+      s => s.for === 'human' || s.for === 'all' || s.for === undefined,
+    );
+    normalized.agentDocumentBlocks = normalized.sections.filter(
+      s => s.for === 'agent' || s.for === 'all',
+    );
+  }
+  return normalized;
+}
+
+/**
+ * Extracts all entries from a 0.20.0 document.
+ * Resolves `refs` pointers to external files relative to baseDir.
+ */
+async function extractV020Entries(doc, baseDir, visited) {
+  const entries = [];
+
+  if (Array.isArray(doc.entries)) {
+    for (const item of doc.entries) {
+      if (item?.$ref) {
+        entries.push(...await resolveRef(item.$ref, baseDir, visited));
+      } else if (item) {
+        entries.push(normalizeEntry(item));
+      }
+    }
+  }
+
+  // `refs` is for document extension/splitting (pointer to other DSDS files)
+  if (Array.isArray(doc.refs)) {
+    for (const ref of doc.refs) {
+      const target = ref.href ?? ref.to;
+      if (target) entries.push(...await resolveRef(target, baseDir, visited));
+    }
+  }
+
+  return entries;
+}
 
 /**
  * Extracts all entities from a parsed DSDS document.
@@ -7,6 +80,9 @@ import { resolve, dirname } from 'node:path';
  * visited prevents circular references.
