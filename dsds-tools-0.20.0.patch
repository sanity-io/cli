     if (!entity?.kind || !entity?.identifier) {
       process.stderr.write(`[dsds-mcp] Intro file at ${filePath} has no valid entity — skipping.\n`);
@@ -130,7 +218,7 @@ export async function loadIntroEntity(filePath) {
