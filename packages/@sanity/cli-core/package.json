{
  "name": "@sanity/cli-core",
  "version": "3.16.0",
  "description": "Sanity CLI core package",
  "keywords": [
    "cli",
    "cms",
    "content",
    "headless",
    "realtime",
    "sanity",
    "tool"
  ],
  "homepage": "https://github.com/sanity-io/cli",
  "bugs": "https://github.com/sanity-io/cli/issues",
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/cli.git",
    "directory": "packages/@sanity/cli-core"
  },
  "files": [
    "./dist",
    "!./dist/**/__tests__"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/_exports/index.js",
  "types": "./dist/_exports/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/_exports/index.ts",
      "default": "./dist/_exports/index.js"
    },
    "./apiClient": {
      "source": "./src/apiClient.ts",
      "default": "./dist/apiClient.js"
    },
    "./commandPolicy": {
      "source": "./src/_exports/commandPolicy.ts",
      "default": "./dist/_exports/commandPolicy.js"
    },
    "./config": {
      "source": "./src/_exports/config.ts",
      "default": "./dist/_exports/config.js"
    },
    "./debug": {
      "source": "./src/_exports/debug.ts",
      "default": "./dist/_exports/debug.js"
    },
    "./dates": {
      "source": "./src/_exports/dates.ts",
      "default": "./dist/_exports/dates.js"
    },
    "./env": {
      "source": "./src/_exports/env.ts",
      "default": "./dist/_exports/env.js"
    },
    "./errors": {
      "source": "./src/_exports/errors.ts",
      "default": "./dist/_exports/errors.js"
    },
    "./installDeferredPackage": {
      "source": "./src/installDeferredPackage.ts",
      "default": "./dist/installDeferredPackage.js"
    },
    "./loadDeferredModule": {
      "source": "./src/loadDeferredModule.ts",
      "default": "./dist/loadDeferredModule.js"
    },
    "./images": {
      "source": "./src/_exports/images.ts",
      "default": "./dist/_exports/images.js"
    },
    "./executionContext": {
      "source": "./src/executionContext.ts",
      "default": "./dist/executionContext.js"
    },
    "./flags": {
      "source": "./src/_exports/flags.ts",
      "default": "./dist/_exports/flags.js"
    },
    "./package-manager": {
      "source": "./src/_exports/package-manager.ts",
      "default": "./dist/_exports/package-manager.js"
    },
    "./request": {
      "source": "./src/_exports/request.ts",
      "default": "./dist/_exports/request.js"
    },
    "./schemas": {
      "source": "./src/_exports/schemas.ts",
      "default": "./dist/_exports/schemas.js"
    },
    "./tasks": {
      "source": "./src/_exports/tasks.ts",
      "default": "./dist/_exports/tasks.js"
    },
    "./telemetry": {
      "source": "./src/_exports/telemetry.ts",
      "default": "./dist/_exports/telemetry.js"
    },
    "./types": {
      "source": "./src/_exports/types.ts",
      "default": "./dist/_exports/types.js"
    },
    "./undeploy": {
      "source": "./src/_exports/undeploy.ts",
      "default": "./dist/_exports/undeploy.js"
    },
    "./util": {
      "source": "./src/_exports/util.ts",
      "default": "./dist/_exports/util.js"
    },
    "./ux": {
      "source": "./src/_exports/ux.ts",
      "default": "./dist/_exports/ux.js"
    },
    "./workbench": {
      "source": "./src/_exports/workbench.ts",
      "default": "./dist/_exports/workbench.js"
    },
    "./SanityCommand": {
      "source": "./src/SanityCommand.ts",
      "default": "./dist/SanityCommand.js"
    },
    "./ExitCodes": {
      "source": "./src/exitCodes.ts",
      "default": "./dist/exitCodes.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "swc --delete-dir-on-start --strip-leading-paths --out-dir dist/ src",
    "build:types": "pkg-utils build --emitDeclarationOnly",
    "check:types": "tsc --noEmit",
    "publint": "publint",
    "test": "vitest run",
    "posttest": "pnpm run lint",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "watch": "swc --delete-dir-on-start --strip-leading-paths --out-dir dist/ --watch src",
    "lint": "oxlint -c oxlint.config.ts"
  },
  "dependencies": {
    "@inquirer/core": "^12.0.6",
    "@inquirer/prompts": "^8.7.5",
    "@oclif/core": "catalog:",
    "@sanity/client": "catalog:",
    "@sanity/generate-help-url": "^4.0.0",
    "@sanity/types": "catalog:",
    "boxen": "^8.0.1",
    "dotenv-expand": "^13.0.0",
    "empathic": "catalog:",
    "execa": "catalog:",
    "get-it": "catalog:",
    "get-tsconfig": "catalog:",
    "import-meta-resolve": "catalog:",
    "jiti": "^2.7.0",
    "json-lexer": "^1.2.0",
    "log-symbols": "^7.0.1",
    "obug": "catalog:",
    "ora": "catalog:",
    "rxjs": "catalog:",
    "wrap-ansi": "^9.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/oxc-config": "workspace:*",
    "@repo/package.config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@sanity/pkg-utils": "catalog:",
    "@sanity/sdk": "catalog:",
    "@sanity/telemetry": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "oxc-transform-react": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "sanity": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@sanity/sdk": "*",
    "babel-plugin-react-compiler": "*",
    "oxc-transform-react": "*",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "@sanity/sdk": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "babel-plugin-react-compiler": {
      "optional": true
    },
    "oxc-transform-react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
