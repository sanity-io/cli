{
  "name": "@sanity/cli-setup",
  "version": "0.1.0",
  "description": "Shared Blueprint setup for the Sanity CLI and create-sanity",
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "swc --delete-dir-on-start --strip-leading-paths --out-dir dist/ src",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sanity/blueprints": "^0.34.1",
    "@sanity/cli-core": "workspace:*"
  },
  "devDependencies": {
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  }
}
