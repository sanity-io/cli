{
  "name": "@sanity/cli-setup",
  "version": "0.1.0",
  "description": "Shared Blueprint workspace setup for the Sanity CLIs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanity-io/cli.git",
    "directory": "packages/@sanity/cli-setup"
  },
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telemetry": {
      "source": "./src/telemetry.ts",
      "types": "./dist/telemetry.d.ts",
      "default": "./dist/telemetry.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "swc --delete-dir-on-start --strip-leading-paths --out-dir dist/ src",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sanity/blueprints": "^0.34.1"
  },
  "devDependencies": {
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  }
}
