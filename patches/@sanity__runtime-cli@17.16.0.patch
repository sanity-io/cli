+                `typeof ${value} === 'object'`,
+                `!Array.isArray(${value})`,
+            ];
+            for (const [name, property] of Object.entries(schema.properties)) {
+                const member = `${value}[${JSON.stringify(name)}]`;
+                const present = `Object.hasOwn(${value}, ${JSON.stringify(name)})`;
+                const check = validationExpression(property.schema, member, depth + 1);
+                checks.push(property.optional
+                    ? `(!${present} || ${member} === undefined || (${check}))`
+                    : `(${present} && (${check}))`);
+            }
+            if (schema.additional) {
+                const key = `key${depth}`;
+                checks.push(`Object.keys(${value}).every(${key} => ${JSON.stringify(Object.keys(schema.properties))}.includes(${key}) || (${validationExpression(schema.additional, `${value}[${key}]`, depth + 1)}))`);
+            }
+            return `(${checks.join(' && ')})`;
+        }
+    }
