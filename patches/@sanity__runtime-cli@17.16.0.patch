@@ -0,0 +1,60 @@
+import { getStack } from '../actions/blueprints/stacks.js';
+import { deployResourcesCore } from '../cores/blueprints/deploy.js';
+import { Logger } from '../utils/logger.js';
+import { readFunctionBuild } from './artifacts.js';
+import { assertAppFunctionStack } from './stack.js';
+/** Deploy already-built PubSub functions to an app-owned organization stack. */
+export async function deployFunctions(options) {
+    const { organizationId, stackId, workDir, fetchFn } = options;
+    const auth = {
+        token: options.token,
+        scopeType: 'organization',
+        scopeId: organizationId,
+    };
+    const result = await getStack({ stackId, auth, fetchFn });
+    if (!result.ok)
+        return { success: false, error: result.error || 'Could not read app function stack' };
+    const stack = result.stack;
+    try {
+        assertAppFunctionStack(stack, options);
+    }
+    catch (error) {
+        return { success: false, error: error instanceof Error ? error.message : String(error) };
+    }
+    if (stack.resources.some((resource) => resource.type !== 'sanity.function.pubsub')) {
+        return {
+            success: false,
+            error: 'The app function stack contains other resource types. Use a dedicated app function stack.',
+        };
+    }
+    const resources = [];
+    for (const fn of options.functions) {
+        let src;
+        try {
+            src = (await readFunctionBuild({ ...fn, workDir })).src;
+        }
+        catch (error) {
+            return { success: false, error: error instanceof Error ? error.message : String(error) };
+        }
+        resources.push({
+            name: fn.name,
+            type: 'sanity.function.pubsub',
+            src,
+            transpile: false,
+            autoResolveDeps: false,
+        });
+    }
+    return deployResourcesCore({
+        auth,
+        stackId,
+        scopeType: 'organization',
+        scopeId: organizationId,
+        deployedStack: stack,
+        resources,
+        workDir,
+        fetchFn,
+        bin: 'sanity',
+        flags: {},
+        log: Logger(options.log, { json: true }),
+    });
+}
