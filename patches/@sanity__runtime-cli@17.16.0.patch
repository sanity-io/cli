+++ b/dist/functions/build.js
@@ -0,0 +1,27 @@
+import path from 'node:path';
+import { findFunctionEntryPoint } from '../utils/functions/find-entry-point.js';
+import { transpileFunction } from '../utils/functions/transpile/function.js';
+import { functionOutputFileName } from './artifacts.js';
+import { functionContractPlugin } from './contractPlugin.js';
+import { generateFunctionContracts } from './contracts.js';
+/** Build a standalone ESM function bundle without a blueprint, stack, or ZIP. */
+export async function buildFunction({ name, src, workDir, outDir, contract, }) {
+    const functionPath = path.resolve(workDir, src);
+    const entryPoint = await findFunctionEntryPoint(functionPath, name);
+    const resolvedContract = contract ?? (await generateFunctionContracts({ workDir, functions: [{ name, src }] }))[0];
+    if (resolvedContract.entryPoint !== entryPoint || resolvedContract.name !== name)
+        throw new Error(`Function contract does not match "${name}".`);
+    const validation = functionContractPlugin(resolvedContract);
+    const result = await transpileFunction({
+        resource: { name, src, type: 'sanity.function.pubsub' },
+        functionPath,
+        entryPoint: validation.entryPoint,
+        plugins: [validation.plugin],
+        workDir,
+        outDir: path.resolve(workDir, outDir),
+        outputFileName: functionOutputFileName,
+        bundle: true,
+    });
+    return { outputDir: result.outputDir };
+}
+export { readFunctionBuild } from './artifacts.js';
