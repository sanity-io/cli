--- /dev/null
+++ b/dist/functions/contracts.js
@@ -0,0 +1,119 @@
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import ts from 'typescript-compiler';
+import { findFunctionEntryPoint } from '../utils/functions/find-entry-point.js';
+import { contractType, schemaFromType } from './contracts/schema.js';
+import { jsonGuard, validatorSource } from './contracts/validation.js';
+/** Discover input and output types without loading or executing function code. */
+export async function generateFunctionContracts(options) {
+    const entries = await Promise.all(options.functions.map(async (fn) => ({
+        ...fn,
+        entryPoint: await findFunctionEntryPoint(path.resolve(options.workDir, fn.src), fn.name),
+    })));
+    const config = readProjectConfig(options.workDir);
+    const program = ts.createProgram(entries.map((fn) => fn.entryPoint), {
+        target: ts.ScriptTarget.ESNext,
+        module: ts.ModuleKind.ESNext,
+        moduleResolution: ts.ModuleResolutionKind.Bundler,
+        ...config?.options,
+        allowJs: true,
+        checkJs: true,
+        noEmit: true,
+        strict: true,
+        strictNullChecks: true,
+        skipLibCheck: true,
+        composite: false,
+        incremental: false,
+        declaration: false,
+        declarationMap: false,
+        tsBuildInfoFile: undefined,
+    });
+    assertDiagnostics(ts.getPreEmitDiagnostics(program), options.workDir);
+    const checker = program.getTypeChecker();
+    return entries.map((fn) => readContract(checker, program, fn));
+}
+/** Check app consumers after regenerating their function registry. */
+export function checkFunctionTypes(workDir) {
+    const config = readProjectConfig(workDir);
+    if (!config)
+        return;
+    const program = ts.createProgram({
+        rootNames: config.fileNames,
+        options: { ...config.options, noEmit: true, incremental: false, tsBuildInfoFile: undefined },
+        projectReferences: config.projectReferences,
+    });
+    assertDiagnostics(ts.getPreEmitDiagnostics(program), workDir);
+}
+function readProjectConfig(workDir) {
+    const configPath = ts.findConfigFile(workDir, ts.sys.fileExists);
+    if (!configPath)
+        return undefined;
+    const config = ts.readConfigFile(configPath, ts.sys.readFile);
+    if (config.error)
+        assertDiagnostics([config.error], workDir);
+    const parsed = ts.parseJsonConfigFileContent(config.config, ts.sys, path.dirname(configPath));
+    assertDiagnostics(parsed.errors, workDir);
+    return parsed;
+}
+function assertDiagnostics(diagnostics, workDir) {
+    const errors = diagnostics.filter((diagnostic) => diagnostic.category === ts.DiagnosticCategory.Error);
+    if (errors.length)
+        throw new Error(ts.formatDiagnostics(errors, {
+            getCanonicalFileName: (file) => file,
+            getCurrentDirectory: () => workDir,
+            getNewLine: () => '\n',
+        }));
+}
+function readContract(checker, program, fn) {
+    const source = program.getSourceFile(fn.entryPoint);
+    const module = source && checker.getSymbolAtLocation(source);
+    const exported = module && checker.getExportsOfModule(module).find((item) => item.getName() === 'handler');
+    if (!source || !exported)
+        throw new Error(`Function "${fn.name}" must export handler.`);
+    const signatures = checker.getTypeOfSymbolAtLocation(exported, source).getCallSignatures();
+    if (signatures.length !== 1)
+        throw new Error(`Function "${fn.name}" must have one handler signature.`);
+    const signature = signatures[0];
+    if (signature.parameters.length > 1)
+        throw new Error(`Function "${fn.name}" must accept a single FunctionArgs envelope.`);
+    let input = { kind: 'void' };
+    const parameter = signature.parameters[0];
+    if (parameter) {
+        const args = checker.getTypeOfSymbolAtLocation(parameter, source);
+        const event = args.getProperty('event');
+        const eventType = event && checker.getTypeOfSymbolAtLocation(event, source);
+        const data = eventType?.getProperty('data');
+        if (!data)
+            throw new Error(`Function "${fn.name}" must annotate its input with FunctionArgs<Input>.`);
+        input = schemaFromType(checker, checker.getTypeOfSymbolAtLocation(data, source), `${fn.name} input`, true);
+    }
+    const isObjectInput = (schema) => schema.kind === 'object' || (schema.kind === 'union' && schema.variants.every(isObjectInput));
+    if (input.kind !== 'void' && !isObjectInput(input))
+        throw new Error(`Function "${fn.name}" input must be a JSON object or omitted. Put scalar values inside an input object.`);
+    const returnType = checker.getReturnTypeOfSignature(signature);
+    const output = schemaFromType(checker, checker.getAwaitedType(returnType) ?? returnType, `${fn.name} output`, true);
+    return { ...fn, input, output };
+}
+const generatedHeader = '// Generated by Sanity CLI. Do not edit.\n';
+/** Emit a standalone declaration registry and browser-safe validators. */
+export async function writeFunctionContracts(workDir, contracts) {
+    const declarations = `${generatedHeader}import '@sanity/sdk'\n\ndeclare module '@sanity/sdk' {\n  interface AppFunctionRegistry {\n${contracts.map((fn) => `    ${JSON.stringify(fn.name)}: {input: ${contractType(fn.input)}; output: ${contractType(fn.output)}}`).join('\n')}\n  }\n}\n`;
+    const client = `${generatedHeader}${jsonGuard}\nexport const functionContracts = Object.fromEntries([\n${contracts.map((fn) => `[${JSON.stringify(fn.name)}, {hasInput: ${fn.input.kind !== 'void'}, validateInput: ${validatorSource(fn.input)}, validateOutput: ${validatorSource(fn.output)}}]`).join(',\n')}\n])\n`;
+    await writeGenerated(path.join(workDir, 'sanity.functions.d.ts'), declarations);
+    await writeGenerated(path.join(workDir, '.sanity', 'function-contracts.js'), client);
+}
+async function writeGenerated(file, content) {
+    try {
+        const previous = await readFile(file, 'utf8');
+        if (!previous.startsWith(generatedHeader))
+            throw new Error(`Refusing to overwrite non-generated file ${file}. Move it before generating function contracts.`);
+        if (previous === content)
+            return;
+    }
+    catch (error) {
+        if (!(error instanceof Error && 'code' in error && error.code === 'ENOENT'))
+            throw error;
+    }
+    await mkdir(path.dirname(file), { recursive: true });
+    await writeFile(file, content);
+}
