index 0000000000000000000000000000000000000000..ee7210016934c8ec5d633ecaab933f2bec496b68
--- /dev/null
+++ b/dist/functions/contracts/schema.js
@@ -0,0 +1,99 @@
+import ts from 'typescript-compiler';
+export function schemaFromType(checker, type, location, allowVoid = false, parents = new Set()) {
+    const fail = (reason) => {
+        throw new Error(`${location}: ${reason} (${checker.typeToString(type)}). Use a concrete JSON-compatible type.`);
+    };
+    const flags = type.flags;
+    if (flags & (ts.TypeFlags.Any | ts.TypeFlags.Unknown | ts.TypeFlags.TypeParameter))
+        return fail('Unresolved or untyped contract');
+    if (flags & ts.TypeFlags.Never)
+        return { kind: 'never' };
+    if (flags & (ts.TypeFlags.Void | ts.TypeFlags.Undefined)) {
+        if (!allowVoid)
+            return fail('Undefined is only supported for optional object fields or a void result');
+        return { kind: 'void' };
+    }
+    if (flags & ts.TypeFlags.Null)
+        return { kind: 'null' };
+    if (flags & ts.TypeFlags.StringLiteral)
+        return { kind: 'literal', value: type.value };
+    if (flags & ts.TypeFlags.NumberLiteral)
+        return { kind: 'literal', value: type.value };
+    if (flags & ts.TypeFlags.BooleanLiteral)
+        return { kind: 'literal', value: checker.typeToString(type) === 'true' };
+    if (flags & ts.TypeFlags.String)
+        return { kind: 'string' };
+    if (flags & ts.TypeFlags.Number)
+        return { kind: 'number' };
+    if (flags & ts.TypeFlags.Boolean)
+        return { kind: 'boolean' };
+    if (parents.has(type) || parents.size > 64)
+        return fail('Recursive or excessively nested contract');
+    const next = new Set(parents).add(type);
+    if (type.isUnion())
+        return {
+            kind: 'union',
+            variants: type.types.map((item) => schemaFromType(checker, item, location, allowVoid, next)),
+        };
+    if (checker.isTupleType(type))
+        return fail('Tuple contracts are not supported; use an array');
+    if (checker.isArrayType(type)) {
+        const element = checker.getTypeArguments(type)[0];
+        return { kind: 'array', items: schemaFromType(checker, element, `${location}[]`, false, next) };
+    }
+    if (!(flags & (ts.TypeFlags.Object | ts.TypeFlags.Intersection)))
+        return fail('Unsupported contract');
+    if (type.getCallSignatures().length || type.getConstructSignatures().length)
+        return fail('Functions and constructors cannot cross the function boundary');
+    if (type
+        .getSymbol()
+        ?.getDeclarations()
+        ?.some((declaration) => ts.isClassDeclaration(declaration) || ts.isClassExpression(declaration)))
+        return fail('Class instances cannot cross the function boundary');
+    if (checker.getIndexTypeOfType(type, ts.IndexKind.Number))
+        return fail('Numeric index signatures are not supported; use an array or string-keyed record');
+    const properties = Object.create(null);
+    for (const property of checker.getPropertiesOfType(type)) {
+        const name = property.getName();
+        if (name.startsWith('__@'))
+            return fail('Symbol properties cannot cross the function boundary');
+        const declaration = property.valueDeclaration ?? property.declarations?.[0];
+        if (!declaration)
+            return fail(`Cannot resolve property ${name}`);
+        const propertyType = checker.getTypeOfSymbolAtLocation(property, declaration);
+        const optional = !!(property.flags & ts.SymbolFlags.Optional);
+        const members = optional
+            ? (propertyType.isUnion() ? propertyType.types : [propertyType]).filter((member) => !(member.flags & ts.TypeFlags.Undefined))
+            : [propertyType];
+        const schemas = members.map((member) => schemaFromType(checker, member, `${location}.${name}`, false, next));
+        properties[name] = {
+            optional,
+            schema: schemas.length === 0
+                ? { kind: 'never' }
+                : schemas.length === 1
+                    ? schemas[0]
+                    : { kind: 'union', variants: schemas },
+        };
+    }
+    const indexType = checker.getIndexTypeOfType(type, ts.IndexKind.String);
+    const additional = indexType
+        ? schemaFromType(checker, indexType, `${location}[key]`, false, next)
+        : undefined;
+    return { kind: 'object', properties, ...(additional ? { additional } : {}) };
+}
+export function contractType(schema) {
+    switch (schema.kind) {
+        case 'literal':
+            return JSON.stringify(schema.value);
+        case 'array':
+            return `(${contractType(schema.items)})[]`;
+        case 'union':
+            return schema.variants.map(contractType).join(' | ');
+        case 'object':
+            return `{${Object.entries(schema.properties)
+                .map(([name, property]) => `${JSON.stringify(name)}${property.optional ? '?' : ''}: ${contractType(property.schema)};`)
+                .join(' ')}${schema.additional ? `[key: string]: ${contractType(schema.additional)};` : ''}}`;
+        default:
+            return schema.kind;
+    }
+}
