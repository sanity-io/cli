@@ -0,0 +1,32 @@
+import { jsonGuard, validatorSource } from './contracts/validation.js';
+/** Build a validating PubSub entry around the original handler. */
+export function functionContractPlugin(contract) {
+    const entryPoint = `virtual:sanity-function-contract:${contract.name}`;
+    const resolvedId = `\0${entryPoint}`;
+    const source = `import {handler as implementation} from ${JSON.stringify(contract.entryPoint.replaceAll('\\', '/'))}
+${jsonGuard}
+const validateInput = ${validatorSource(contract.input)}
+const validateOutput = ${validatorSource(contract.output)}
+export async function handler(envelope) {
+  let input = envelope?.event?.data
+  ${contract.input.kind === 'void' ? "if (input !== null && typeof input === 'object' && !Array.isArray(input) && Object.keys(input).length === 0) input = undefined" : ''}
+  if (!validateInput(input)) throw new TypeError(${JSON.stringify(`Invalid input for function "${contract.name}". Match its declared input type.`)})
+  const result = await implementation(envelope)
+  if (!validateOutput(result)) throw new TypeError(${JSON.stringify(`Function "${contract.name}" returned data that does not match its declared return type.`)})
+  return result
+}`;
+    return {
+        entryPoint,
+        plugin: {
+            name: 'sanity/function-contract',
+            resolveId(id) {
+                if (id === entryPoint)
+                    return resolvedId;
+            },
+            load(id) {
+                if (id === resolvedId)
+                    return source;
+            },
+        },
+    };
+}
