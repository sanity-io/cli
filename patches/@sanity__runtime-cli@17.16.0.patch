@@ -0,0 +1,26 @@
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+import { findFunctionEntryPoint } from '../utils/functions/find-entry-point.js';
+export const functionOutputFileName = 'index.js';
+/** Validate artifacts produced by buildFunction before packaging or deployment. */
+export async function readFunctionBuild(options) {
+    const { name, workDir } = options;
+    const src = path.resolve(workDir, options.src);
+    try {
+        const pkg = JSON.parse(await readFile(path.join(src, 'package.json'), 'utf8'));
+        if (!pkg ||
+            typeof pkg !== 'object' ||
+            !('main' in pkg) ||
+            pkg.main !== functionOutputFileName ||
+            !('type' in pkg) ||
+            pkg.type !== 'module')
+            throw new Error('The function package metadata does not match its build format.');
+        const entryPoint = await findFunctionEntryPoint(src, name);
+        if (entryPoint !== path.join(src, functionOutputFileName))
+            throw new Error(`The compiled entry ${functionOutputFileName} is missing.`);
+        return { name, src, entryPoint };
+    }
+    catch (error) {
+        throw new Error(`Function "${name}" is not built. Run sanity build first.`, { cause: error });
+    }
+}
