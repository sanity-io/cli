+++ b/dist/functions/stack.js
@@ -0,0 +1,84 @@
+import { createStack, getStack, listStacks } from '../actions/blueprints/stacks.js';
+import { Logger } from '../utils/logger.js';
+/** Shared ownership check for provisioning and deploying an app's function stack. */
+export function assertAppFunctionStack(stack, { appId, organizationId }) {
+    if (!stack ||
+        typeof stack.id !== 'string' ||
+        !stack.id ||
+        stack.name !== appFunctionStackName(appId) ||
+        stack.scopeType !== 'organization' ||
+        stack.scopeId !== organizationId) {
+        throw new Error(`The function stack does not belong to app "${appId}" in organization "${organizationId}". Check .sanity/app-functions.json.`);
+    }
+}
+/** Resolve or create a dedicated app stack using the Blueprint stack operations. */
+export async function ensureFunctionStack(options) {
+    const { appId, organizationId, token, fetchFn, stackId, dryRun = false } = options;
+    const auth = { token, scopeType: 'organization', scopeId: organizationId };
+    const name = appFunctionStackName(appId);
+    const logger = Logger(() => { }, { json: true });
+    const resolved = (stack, created) => {
+        assertAppFunctionStack(stack, options);
+        return { created, id: stack.id };
+    };
+    if (stackId) {
+        const result = await getStack({ stackId, auth, fetchFn });
+        if (result.ok)
+            return resolved(result.stack, false);
+        if (result.response?.status !== 404)
+            throw stackRequestError(result);
+    }
+    async function findStack() {
+        let cursor;
+        const cursors = new Set();
+        do {
+            const result = await listStacks(auth, logger, { fetchFn, cursor, limit: 500 });
+            if (!result.ok)
+                throw stackRequestError(result);
+            if (!Array.isArray(result.stacks))
+                throw new Error('Invalid Blueprint stack list response.');
+            const stack = result.stacks.find((item) => item?.name === name);
+            if (stack)
+                return stack;
+            if (result.response?.headers.get('x-has-more') !== 'true')
+                return undefined;
+            cursor = result.response.headers.get('x-cursor') ?? undefined;
+            if (!cursor || cursors.has(cursor))
+                throw new Error('Cannot read the next page of Blueprint stacks. Try again.');
+            cursors.add(cursor);
+        } while (cursor);
+        return undefined;
+    }
+    const existing = await findStack();
+    if (existing)
+        return resolved(existing, false);
+    if (dryRun)
+        return null;
+    const result = await createStack({
+        auth,
+        logger,
+        fetchFn,
+        stackMutation: {
+            name,
+            scopeType: auth.scopeType,
+            scopeId: auth.scopeId,
+            document: { resources: [] },
+        },
+    });
+    if (result.ok)
+        return resolved(result.stack, true);
+    if (result.response?.status === 409) {
+        const concurrent = await findStack();
+        if (concurrent)
+            return resolved(concurrent, false);
+    }
+    throw stackRequestError(result);
+}
+function appFunctionStackName(appId) {
+    return `app-${appId}`;
+}
+function stackRequestError(result) {
+    const status = result.response ? ` (${result.response.status})` : '';
+    return new Error(`Blueprint stack request failed${status}: ${result.error || result.response?.statusText || 'Unknown error'}`);
+}
+export { BLUEPRINTS_API_VERSION } from '../config.js';
